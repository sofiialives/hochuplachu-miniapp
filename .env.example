PORT=4000
# HOST=127.0.0.1 — слушать только localhost. По умолчанию dev-сервер
# слушает 0.0.0.0 (доступен по LAN-IP), --allowed-hosts=all отключает
# host-check.
HOST=0.0.0.0

# API
API_BASE_URL=http://localhost:8080/api/v1
COINCAT_PUBLIC_URL=https://coincat.in

# Theme overrides (optional — defaults are from DESIGN.md)
BRAND_PRIMARY_COLOR=
BRAND_INK_COLOR=
BRAND_CANVAS_COLOR=
LOGO_URL=

# Provider
PROVIDER=cc

# Telegram
TELEGRAM_BOT_USERNAME=hochuplachu_bot

# Analytics
MATOMO_URL=
MATOMO_SITE_ID=
YANDEX_METRIKA_ID=

# Links
KNOWLEDGE_BASE_URL=
SUPPORT_BOT_URL=
WEB_BASE_URL=http://localhost:4000
